<odoo>
    <record id="odoo_module_branch_model_view_form" model="ir.ui.view">
        <field name="name">odoo.module.branch.model.form</field>
        <field name="model">odoo.module.branch.model</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="open_inherited_models"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-sitemap"
                        >
                            <span>Inheritance</span>
                        </button>
                        <button
                            name="open_next_odoo_version_model"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-arrow-up"
                            invisible="not next_odoo_version_model_id"
                        >
                            <span>Next Version</span>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="module_branch_id" />
                            <field name="odoo_model_version_id" string="Model" />
                            <field name="inherit_ids" widget="many2many_tags" />
                            <field name="inherits_ids" widget="many2many_tags" />
                        </group>
                        <group>
                            <field name="model_type" />
                            <field name="order" />
                            <field name="global_dependency_level" />
                            <field name="root_id" invisible="not root_id" />
                            <field
                                role="alert"
                                class="alert alert-danger"
                                name="root_warning"
                                nolabel="1"
                                colspan="2"
                                invisible="not root_warning"
                            />
                        </group>
                    </group>
                    <notebook>
                        <page name="fields" string="Fields" invisible="not field_ids">
                            <group>
                                <field name="field_ids" colspan="2" nolabel="1">
                                    <list decoration-danger="not active">
                                        <field name="name" />
                                        <field name="field_type" />
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page
                            name="methods"
                            string="Methods"
                            invisible="not method_ids"
                        >
                            <group>
                                <field name="method_ids" colspan="2" nolabel="1">
                                    <list decoration-danger="not active">
                                        <field name="signature" />
                                        <field name="root_id" />
                                        <button
                                            name="open_parent_methods"
                                            type="object"
                                            class="oe_stat_button"
                                            icon="fa-code-fork"
                                            title=" "
                                            invisible="not parent_ids"
                                        />
                                    </list>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="odoo_module_branch_model_view_tree" model="ir.ui.view">
        <field name="name">odoo.module.branch.model.list</field>
        <field name="model">odoo.module.branch.model</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="module_branch_id" />
                <field name="odoo_model_id" />
                <field name="inherit_ids" />
                <field name="inherits_ids" />
                <field name="model_type" />
                <field name="root_id" optional="hide" />
                <field name="global_dependency_level" optional="hide" />
            </list>
        </field>
    </record>

    <record id="odoo_module_branch_model_view_tree2" model="ir.ui.view">
        <field name="name">odoo.module.branch.model.tree2</field>
        <field name="model">odoo.module.branch.model</field>
        <field name="arch" type="xml">
            <list>
                <field name="odoo_model_id" />
                <field name="inherit_ids" />
                <field name="inherits_ids" />
                <field name="model_type" />
                <field name="root_id" optional="hide" />
                <field name="global_dependency_level" optional="hide" />
            </list>
        </field>
    </record>

    <record id="odoo_module_branch_model_view_search" model="ir.ui.view">
        <field name="name">odoo.module.branch.model.search</field>
        <field name="model">odoo.module.branch.model</field>
        <field name="type">search</field>
        <field name="arch" type="xml">
            <search>
                <field name="odoo_model_id" />
                <field name="inherit_ids" />
                <field name="module_id" />
                <field name="odoo_version_id" />
                <field name="field_ids" />
                <field name="method_ids" />
                <field name="repository_id" />
                <field name="org_id" />
                <filter
                    name="abstract_model"
                    string="AbstractModel"
                    domain="[('model_type', '=', 'AbstractModel')]"
                />
                <filter
                    name="model"
                    string="Model"
                    domain="[('model_type', '=', 'Model')]"
                />
                <filter
                    name="transient_model"
                    string="TransientModel"
                    domain="[('model_type', '=', 'TransientModel')]"
                />
                <filter
                    name="inactive"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="group_by_odoo_model_id"
                        string="Model"
                        context="{'group_by': 'odoo_model_id'}"
                    />
                    <filter
                        name="group_by_module_name"
                        string="Module"
                        context="{'group_by': 'module_name'}"
                    />
                    <filter
                        name="group_by_odoo_version_id"
                        string="Odoo Version"
                        context="{'group_by': 'odoo_version_id'}"
                    />
                    <filter
                        name="group_by_org_id"
                        string="Organization"
                        context="{'group_by': 'org_id'}"
                    />
                    <filter
                        name="group_by_repository_id"
                        string="Repository"
                        context="{'group_by': 'repository_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="odoo_module_branch_model_action" model="ir.actions.act_window">
        <field name="name">Models</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">odoo.module.branch.model</field>
        <field name="view_id" ref="odoo_module_branch_model_view_tree" />
        <field name="context">{'search_default_group_by_odoo_version_id': 1}</field>
    </record>

    <menuitem
        id="odoo_module_branch_model_menu"
        parent="code_odoo_repository_menu"
        action="odoo_module_branch_model_action"
        sequence="20"
    />
</odoo>
