<odoo>
    <record id="odoo_module_branch_timeline_view_form" model="ir.ui.view">
        <field name="name">odoo.module.branch.timeline.form</field>
        <field name="model">odoo.module.branch.timeline</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        string="Restore"
                        name="toggle_active"
                        type="object"
                        invisible="active"
                        data-hotkey="x"
                    />
                    <button
                        name="action_scan"
                        type="object"
                        string="Scan"
                        class="btn-primary"
                        groups="odoo_repository.group_odoo_repository_manager"
                        invisible="not migration_scan"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="open_migrations"
                            string="Migrations"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-list"
                            invisible="not migration_ids"
                        />
                    </div>
                    <div
                        class="alert alert-warning"
                        role="alert"
                        invisible="module_branch_id == last_known_module_branch_id"
                        name="last_known_module_alert"
                    >
                        The selected module version is not the last one available.
                        Recording such timeline will ignore all newest versions when computing related migration data.
                    </div>
                    <div
                        class="alert alert-warning"
                        role="alert"
                        invisible="not migration_scan"
                        name="migration_scan_alert"
                    >
                        A scan of related modules is required to update relevant migration data.  Wait for the next scheduled scan, or trigger one manually.
                    </div>
                    <group name="info" string="Info">
                        <field name="module_branch_id" />
                        <field name="last_known_module_branch_id" />
                        <field name="odoo_version_id" />
                        <field name="state" />
                        <field name="next_module_id" />
                        <field
                            name="next_module_branch_id"
                            invisible="not next_module_branch_id"
                        />
                    </group>
                    <group name="note" string="Notes">
                        <field name="note" colspan="2" nolabel="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="odoo_module_branch_timeline_view_tree" model="ir.ui.view">
        <field name="name">odoo.module.branch.timeline.list</field>
        <field name="model">odoo.module.branch.timeline</field>
        <field name="arch" type="xml">
            <list>
                <field name="odoo_version_id" />
                <field name="module_branch_id" />
                <field name="state" />
                <field name="next_module_id" />
            </list>
        </field>
    </record>

    <record id="odoo_module_branch_timeline_view_search" model="ir.ui.view">
        <field name="name">odoo.module.branch.timeline.search</field>
        <field name="model">odoo.module.branch.timeline</field>
        <field name="type">search</field>
        <field name="arch" type="xml">
            <search>
                <field name="odoo_version_id" />
                <field name="module_branch_id" />
                <field name="org_id" />
                <field name="repository_id" />
                <field name="state" />
                <field name="next_module_id" />
                <filter
                    name="renamed"
                    string="Renamed"
                    domain="[('state', '=', 'renamed')]"
                />
                <filter
                    name="replaced"
                    string="Replaced"
                    domain="[('state', '=', 'replaced')]"
                />
                <separator />
                <filter
                    string="Archived"
                    name="archived"
                    domain="[('active', '=', False)]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="group_by_org_id"
                        string="Organization"
                        context="{'group_by': 'org_id'}"
                    />
                    <filter
                        name="group_by_repository_id"
                        string="Repository"
                        context="{'group_by': 'repository_id'}"
                    />
                    <filter
                        name="group_by_odoo_version_id"
                        string="Odoo Version"
                        context="{'group_by': 'odoo_version_id'}"
                    />
                    <filter
                        name="group_by_state"
                        string="State"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="odoo_module_branch_timeline_action" model="ir.actions.act_window">
        <field name="name">Timelines</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">odoo.module.branch.timeline</field>
        <field name="view_id" ref="odoo_module_branch_timeline_view_tree" />
        <field name="context">{'search_default_group_by_org_id': 1}</field>
    </record>

    <menuitem
        id="odoo_module_branch_timeline_menu"
        parent="odoo_repository.modules_odoo_repository_menu"
        action="odoo_module_branch_timeline_action"
        sequence="20"
    />
</odoo>
