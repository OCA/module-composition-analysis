<odoo>
    <record
        id="queue_job_function_odoo_project_resolve_dependencies"
        model="queue.job.function"
    >
        <field name="model_id" ref="model_odoo_project" />
        <field name="method">_resolve_dependencies_job</field>
        <field name="channel_id" ref="odoo_repository.queue_job_channel_scan" />
        <field name="retry_pattern" eval="{1: 1, 5: 5, 10: 10, 15: 30}" />
    </record>

    <record
        id="queue_job_function_odoo_project_module_analyse_pinned_revision"
        model="queue.job.function"
    >
        <field name="model_id" ref="model_odoo_project_module" />
        <field name="method">_analyse_pinned_revision</field>
        <field name="channel_id" ref="odoo_repository.queue_job_channel_scan" />
        <field name="retry_pattern" eval="{1: 1, 5: 5, 10: 10, 15: 30}" />
    </record>
</odoo>
