<odoo>
    <record id="odoo_module_branch_timeline_view_form" model="ir.ui.view">
        <field name="name">odoo.module.branch.timeline.form.inherit</field>
        <field name="model">odoo.module.branch.timeline</field>
        <field
            name="inherit_id"
            ref="odoo_repository_migration.odoo_module_branch_timeline_view_form"
        />
        <field name="arch" type="xml">
            <div name="button_box">
                <button
                    name="open_project_migrations"
                    string="Project Migrations"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-list"
                    invisible="not project_migration_ids"
                />
            </div>
        </field>
    </record>
</odoo>
